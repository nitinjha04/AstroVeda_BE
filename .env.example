NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=AstroVerse
APP_URL=http://localhost:5000
# Hostinger site origin(s) in production, e.g. https://yourdomain.com
CLIENT_URL=http://localhost:5173
# Comma-separated extras: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

# MongoDB Atlas (required on Render)
MONGODB_URI=mongodb://127.0.0.1:27017/astroverse

# Optional Redis / Upstash (leave empty on free Render → in-memory mock)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ALLOW_INMEMORY_REDIS=true

# JWT (use long random secrets on Render)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin seed
ADMIN_EMAIL=admin@astroverse.com
ADMIN_PASSWORD=Admin@AstroVerse2026
ADMIN_NAME=Super Admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenRouter AI (https://openrouter.ai) — OpenAI-compatible
# Use a free model (:free) so you do not get billed
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free / cheapest default — change only if this model is unavailable
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MAX_TOKENS=256
FORCE_CHEAP_AI_MODEL=true

# Deprecated fallback name (optional)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_GATEWAY=razorpay

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AstroVerse <noreply@astroverse.com>

GOOGLE_CLIENT_ID=

OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

DEFAULT_AI_PRICE_PER_MINUTE=5
MIN_WALLET_RECHARGE=50
MAX_WALLET_RECHARGE=50000
PLATFORM_COMMISSION_PERCENT=20

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Dev only — memory Mongo if local DB down
USE_MEMORY_MONGO=true
